# ═══════════════════════════════════════════════
# AI CyberShield — Environment Configuration
# ═══════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_NAME="AI CyberShield"
APP_ENV="development"
APP_HOST="0.0.0.0"
APP_PORT=8000
API_VERSION="0.1.0"
DEBUG=true

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/cybershield"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ──────────────────────────────────────────────
# Model
# ──────────────────────────────────────────────
MODEL_PATH="./ml/artifacts/model.pkl"
MODEL_TYPE="xgboost"
MODEL_VERSION="0.1.0"
MODEL_THRESHOLD=0.5
MODEL_DEVICE="cpu"
MODEL_VERBOSITY=0

# ──────────────────────────────────────────────
# ML Pipeline
# ──────────────────────────────────────────────
RANDOM_STATE=42
N_JOBS=-1
TRAIN_TEST_SPLIT=0.2
TRAIN_VAL_SPLIT=0.1
CV_FOLDS=5
SCORING_METRIC="f1_macro"
EARLY_STOPPING_ROUNDS=50

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_OUTPUT="./logs"
LOG_FILE_PATH="./logs/cybershield.log"
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_DATE_FORMAT="%Y-%m-%d %H:%M:%S"

# ──────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────
SECRET_KEY="change-me-to-a-random-secret-key"
JWT_ALGORITHM="HS256"
TOKEN_EXPIRY=3600

# ──────────────────────────────────────────────
# Dataset
# ──────────────────────────────────────────────
DATASET_SOURCE="CICIDS2017"
DATASET_TARGET_COLUMN="Label"
DATASET_SAMPLE_SIZE=1.0
DATASET_RANDOM_SEED=42
