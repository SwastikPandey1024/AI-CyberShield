# ──────────────────────────────────────────────
# AI CyberShield — Environment Configuration
# ──────────────────────────────────────────────
# Copy this file to .env and adjust values.
# NEVER commit the actual .env file.

# Application
APP_NAME="AI CyberShield"
APP_VERSION="0.1.0"
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/ai_cybershield

# ML Model
MODEL_PATH=ml/artifacts/models
SCALER_PATH=ml/artifacts/metadata

# Server
HOST=0.0.0.0
PORT=8000
