# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
*.whl
*.manifest
*.spec
*.so

# ──────────────────────────────────────────────
# Virtual Environment
# ──────────────────────────────────────────────
.venv/
venv/
env/
virtualenv/

# ──────────────────────────────────────────────
# Jupyter Notebooks
# ──────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints/
*/.ipynb_checkpoints/*
poetry.lock

# ──────────────────────────────────────────────
# ML Artifacts & Model Checkpoints
# ──────────────────────────────────────────────
# Ignore large/temp model artifacts but track key model metadata and selected model
ml/artifacts/models/*
!ml/artifacts/models/.gitkeep
!ml/artifacts/models/metrics.json
!ml/artifacts/models/feature_names.json
!ml/artifacts/models/model.pkl
ml/artifacts/metadata/*
!ml/artifacts/metadata/.gitkeep
ml/artifacts/*.pkl
ml/artifacts/*.joblib
ml/artifacts/*.h5
ml/artifacts/*.pt
ml/artifacts/*.onnx
*.checkpoint*
*.ckpt

# ──────────────────────────────────────────────
# Datasets
# ──────────────────────────────────────────────
# Ignore raw/processed data files but track manifests, logs, and gitkeeps
datasets/raw/*
!datasets/raw/.gitkeep
!datasets/raw/CICIDS2017/.gitkeep
datasets/raw/CICIDS2017/*
datasets/processed/*
!datasets/processed/.gitkeep
!datasets/processed/CICIDS2017/
datasets/processed/CICIDS2017/*
!datasets/processed/CICIDS2017/manifest.json
!datasets/processed/CICIDS2017/preprocessing_log.md
datasets/external/*
!datasets/external/.gitkeep
datasets/*.csv
datasets/*.pcap
datasets/*.parquet
datasets/*.h5
datasets/*.bin
datasets/*.zip
datasets/*.gz
datasets/*.tar

# ──────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────
*.log
*.log.*
logs/
!logs/.gitkeep

# ──────────────────────────────────────────────
# IDE / Editors
# ──────────────────────────────────────────────
.vscode/settings.json
.vscode/*.code-snippets
.vscode/tasks.json
.vscode/launch.json
.idea/
*.iml
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.project
.classpath

# ──────────────────────────────────────────────
# Environment Variables
# ──────────────────────────────────────────────
.env
.env.*
!.env.example
.env.local
.env.production
.env.development

# ──────────────────────────────────────────────
# Testing
# ──────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
coverage.xml
*.coverage
*.coverage.*
.cache/
test-results/
junit/
junit.xml

# ──────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────
docker/.env
docker-compose.override.yml

# ──────────────────────────────────────────────
# Operating System
# ──────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ──────────────────────────────────────────────
# Reports & Data Science Artifacts
# ──────────────────────────────────────────────
# Ignore generated figures and profiling outputs but track directory structure
reports/data/profiling/*.html
reports/data/profiling/*.json
reports/data/profiling/figures/feature_distributions/*
!reports/data/profiling/figures/feature_distributions/.gitkeep
reports/data/eda/*.ipynb
reports/data/eda/*.html
!reports/data/eda/.gitkeep
reports/data/validation/*
!reports/data/validation/.gitkeep

